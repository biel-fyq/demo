/* 整体容器 */
.login-container {
  width: 100vw;
  height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  /* 垂直居中 */
  align-items: center;
  /* 水平居中 */
  background-color: #ffffff;
}


/* 表单容器 */
.form-container {
  width: 80%;
  max-width: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 用户信息区域 */
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 头像样式 */
.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

/* 昵称输入区域 */
.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
  margin-bottom: 40rpx;
}

.nickname-label {
  width: 105px;
  font-size: 30rpx;
}

.nickname-input {
  flex: 1;
  font-size: 30rpx;
}

.confirm-button {
  margin-top: 40rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #54DD67;
  color: white;
  font-size: 32rpx;
  border-radius: 45rpx;
  text-align: center;
  padding: 0;
}


.login-page {
  width: 100%;
  height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* 主内容区域 */
.main-content {
  padding: 0 60rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo 区域外层容器 */
.logo-section {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 128rpx;
}

/* 新布局：用于包裹圆形背景和居中图片 */
.flex-center-container {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 268rpx;
  height: 268rpx;
}


/* 居中的 Logo 图片，放在背景之上 */
.centered-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 480rpx;
  height: 480rpx;
  z-index: 2;
}

.welcome-text-login {
  margin-bottom: 128rpx;
  text-align: center;
  animation: welcomeTextFadeIn 1s ease-in-out 0.6s both;
}

.welcome-title-login {
  font-size: 48rpx;
  font-weight: bold;
  color: #000000;
  font-family: MiSans;
  font-weight: 700;
  font-style: Bold;
  line-height: 160%;
  letter-spacing: 0px;
  text-align: center;
}

.welcome-text {
  margin-bottom: 120rpx;
  text-align: center;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #000000;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  gap: 50rpx;
  animation: buttonFadeIn 1s ease-in-out 0.9s both;
}

/* 通用按钮样式 */
.wechat-btn,
.cancel-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
  transition: all 0.3s ease;
}

/* 微信登录按钮 */
.wechat-btn {
  background: #54DD67;
  gap: 20rpx;
}

.wechat-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.wechat-icon {
  width: 34rpx;
  height: 34rpx;
}

.btn-text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  line-height: 20px;
  letter-spacing: 0px;
  text-align: center;
}

/* 取消按钮 */
.cancel-btn {
  background-color: #CDCDCD;
}

.cancel-btn:active {
  transform: scale(0.98);
  background-color: #e8e8e8;
}

/* 移除小程序按钮默认的点击态 */
.wechat-btn::after,
.cancel-btn::after {
  border: none;
}

/* 动画定义 */
@keyframes logoFadeIn {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 图片渐入动画 */
@keyframes imageFadeIn {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

/* 图片渐入动画类 */
.fade-in-image {
  animation: imageFadeIn 1.5s ease-in-out;
}

@keyframes welcomeTextFadeIn {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes buttonFadeIn {
  0% {
    opacity: 0;
    transform: translateY(50rpx);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

